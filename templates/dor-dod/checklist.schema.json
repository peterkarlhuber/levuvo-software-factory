{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:levuvo:sf:schema:dor-dod:0.2",
  "title": "Levuvo SF Definition of Ready / Definition of Done (A5, GA5.2, R4, R8)",
  "description": "Proposed by the factory from the stack profile, approved by the human, stored in the factory (not in agent-writable project content). Only items with mandatory: true and verification: automated generate mandatory gates; mandatory review and human items are enforced at their workflow transitions. A schema-valid checklist is not approved until the factory records the human's approval of this exact version (GA5.2).",
  "type": "object",
  "required": [
    "kind",
    "version",
    "stack_profile",
    "items"
  ],
  "properties": {
    "kind": {
      "enum": [
        "definition-of-ready",
        "definition-of-done"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "stack_profile": {
      "type": "string"
    },
    "approved_by": {
      "type": "string",
      "description": "Factory-managed."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "mandatory",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(DOR|DOD)-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          },
          "verification": {
            "enum": [
              "automated",
              "review",
              "human"
            ],
            "description": "automated = factory gate; review = independent reviewer; human = acceptance."
          },
          "gate": {
            "type": "object",
            "description": "Required for automated DoD items; run by the factory in its own container (G5.3). Automated DoR items are checked by check_ready on the spec draft and need no gate.",
            "required": [
              "name",
              "command",
              "result_format"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "result_format": {
                "enum": [
                  "junit-xml",
                  "sarif",
                  "exit-code"
                ]
              },
              "threshold": {
                "type": "string",
                "description": "E.g. minimum coverage; a setting (M3)."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "definition-of-ready"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "pattern": "^DOR-[0-9]+$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "definition-of-done"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "pattern": "^DOD-[0-9]+$"
                }
              },
              "if": {
                "properties": {
                  "verification": {
                    "const": "automated"
                  }
                }
              },
              "then": {
                "required": [
                  "gate"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

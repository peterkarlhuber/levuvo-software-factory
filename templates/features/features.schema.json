{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:levuvo:sf:schema:features:0.1",
  "title": "Levuvo SF feature list (A3, GA3.3-GA3.5)",
  "description": "Source of docs/FEATURES.md (rendered by the factory). IDs and statuses are set by the factory only.",
  "type": "object",
  "required": ["prd_version", "next_id", "features"],
  "properties": {
    "prd_version": { "type": "string", "description": "PRD version the scope check was made against." },
    "next_id": { "type": "integer", "minimum": 1, "description": "IDs are never reused (GA3.3)." },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "priority", "depends_on", "scope_ref", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 1, "description": "One sentence." },
          "priority": { "enum": ["must", "should", "could", "wont"], "description": "MoSCoW, preliminary; work order is decided later." },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^F-[0-9]{3,}$" }, "uniqueItems": true },
          "scope_ref": { "type": "string", "description": "Capability in PRD section 7 this feature belongs to (GA3.4)." },
          "status": { "enum": ["proposed", "approved", "removed"], "description": "Part A statuses; part B extends the list. Set by the factory state machine (GA3.5)." },
          "source": { "type": "string", "description": "briefing/<path>, answer <id> or attachment <path>." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

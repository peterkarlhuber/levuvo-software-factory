{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:levuvo:sf:schema:briefing-inventory:0.1",
  "title": "Levuvo SF briefing inventory (A1, GA1.2-GA1.5, G2.5)",
  "description": "Generated by the factory only. A new version is created whenever a file in briefing/ is added, changed or deleted; tags are metadata and do not create a new version (GA2.3). Paths are canonical, factory-generated and inside briefing/; traversal and symlink escapes are rejected before file access. Schema validation is not an authorization check.",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "files"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "size_bytes",
          "sha256",
          "readable",
          "secret_scan",
          "added_via"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^briefing/",
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          },
          "media_type": {
            "type": "string",
            "description": "IANA media type."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lfs": {
            "type": "boolean",
            "description": "Stored via Git LFS (GA1.3)."
          },
          "readable": {
            "type": "boolean",
            "description": "Agents can read the actual content (GA1.5)."
          },
          "unreadable_reason": {
            "type": "string"
          },
          "secret_scan": {
            "type": "object",
            "required": [
              "status",
              "scanned_at"
            ],
            "properties": {
              "status": {
                "enum": [
                  "clean",
                  "blocked"
                ],
                "description": "blocked = secret detected; no agent access until resolved (GA1.4)."
              },
              "scanner": {
                "type": "string"
              },
              "scanned_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "added_via": {
            "enum": [
              "upload",
              "answer"
            ]
          },
          "answer_ref": {
            "type": "string",
            "description": "Question id when added_via = answer (G2.5)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tag",
                "set_by"
              ],
              "properties": {
                "tag": {
                  "enum": [
                    "design-reference"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "set_by": {
                  "type": "string",
                  "description": "Run id or human."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "readable": {
                  "const": false
                }
              }
            },
            "then": {
              "required": [
                "unreadable_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "secret_scan": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "readable": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "added_via": {
                  "const": "answer"
                }
              }
            },
            "then": {
              "required": [
                "answer_ref"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

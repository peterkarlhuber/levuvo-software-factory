{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:levuvo:sf:schema:spec:0.3",
  "title": "Levuvo SF feature spec (B1, GB1.2, GB1.3, R1)",
  "description": "Source of features/<ID>/SPEC.md (rendered by the factory). Written by the spec agent through tools; version, hash and approval are set by the factory only. The factory additionally checks that AC IDs carry the feature number, are unique and never reused across versions (a modified criterion keeps its ID; new IDs are always assigned by the factory), and that the contract file is valid.",
  "type": "object",
  "required": ["feature_id", "version", "status", "baselines", "user_stories", "requirements", "out_of_scope", "open_questions"],
  "properties": {
    "feature_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "version": { "type": "integer", "minimum": 1, "description": "Set by the factory; a change is a new version (GB1.3)." },
    "previous_version": { "type": "integer", "minimum": 1, "description": "Set for revisions (G1.3)." },
    "status": { "enum": ["draft", "approved", "released", "superseded"], "description": "Set by the factory. approved = approved by the human, on the feature or fix branch, not yet merged; released = merged into main with its code (G1.5); at most one approved version per feature." },
    "approved_by": { "type": "string", "description": "Factory-managed." },
    "approved_at": { "type": "string", "format": "date-time", "description": "Factory-managed." },
    "baselines": {
      "type": "object",
      "description": "Versions the spec was written against; set by the factory.",
      "required": ["prd", "architecture", "dor"],
      "properties": {
        "prd": { "type": "integer", "minimum": 1 },
        "architecture": { "type": "integer", "minimum": 1 },
        "design_system": { "type": "integer", "minimum": 1, "description": "Missing when no design system applies." },
        "dor": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "user_stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["as_a", "i_want", "so_that", "source"],
        "properties": {
          "as_a": { "type": "string", "minLength": 1, "description": "User group from PRD section 3." },
          "i_want": { "type": "string", "minLength": 1 },
          "so_that": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/source" }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ears", "text", "source", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}-[0-9]{2,}$" },
          "ears": { "enum": ["ubiquitous", "event", "state", "unwanted", "optional", "complex"], "description": "EARS pattern: ubiquitous (The system shall …), event (When …), state (While …), unwanted (If … then …), optional (Where …), complex (combination)." },
          "text": { "type": "string", "minLength": 1, "description": "One EARS sentence with exactly one 'shall'." },
          "source": { "$ref": "#/$defs/source" },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "description": "Every requirement has at least one acceptance criterion (GB1.2).",
            "items": { "$ref": "#/$defs/acceptance_criterion" }
          }
        },
        "additionalProperties": false
      }
    },
    "contract": {
      "type": "object",
      "description": "Only for API features: the endpoints this feature adds or changes (OpenAPI, or the format named by the API-style ADR); the factory merges it into docs/openapi.yaml on the branch.",
      "required": ["format", "path"],
      "properties": {
        "format": { "type": "string", "description": "E.g. openapi-3.1.1." },
        "path": { "type": "string", "pattern": "^features/F-[0-9]{3,}/[^/]+$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      },
      "additionalProperties": false
    },
    "ui_reference": {
      "type": "object",
      "description": "Only if a design system applies.",
      "required": ["screens"],
      "properties": {
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "route", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "route": { "type": "string", "pattern": "^/", "description": "Path under the base URL where the screen is reached, e.g. /bookings/new. Part of the contract: hidden tests navigate here (stack profile test interface)." },
              "description": { "type": "string", "minLength": 1, "description": "What the user sees and does, incl. visible labels the acceptance criteria rely on." },
              "components": { "type": "array", "items": { "type": "string" }, "description": "Components from DESIGN-SYSTEM.md." }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "supersedes": {
      "type": "array",
      "description": "Criteria of other done features this spec changes openly (GB1.6). Approved with this spec; the factory releases the affected specs with the merge.",
      "items": {
        "type": "object",
        "required": ["feature_id", "ac", "op", "reason"],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "ac": { "type": "string", "pattern": "^AC-[0-9]{3,}-[0-9]{2,}$" },
          "op": { "enum": ["modify", "remove"] },
          "text": { "type": "string", "minLength": 1, "description": "New pass/fail statement (modify only)." },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false,
        "if": { "properties": { "op": { "const": "modify" } } },
        "then": { "required": ["text"] },
        "else": { "not": { "required": ["text"] } }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "May be empty, but must be stated." },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "blocking"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean", "description": "Blocking questions prevent approval; non-blocking ones need explicit human acceptance (GB1.5)." },
          "accepted_by_human": { "type": "boolean", "description": "Factory-managed." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": { "type": "string", "minLength": 1, "description": "PRD section, briefing/<path>, answer <id> or attachment <path>." },
    "acceptance_criterion": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]{3,}-[0-9]{2,}$" },
        "statement": { "type": "string", "minLength": 1, "description": "One pass/fail statement, checkable by an automated test." },
        "gherkin": {
          "type": "object",
          "description": "Gherkin scenario where useful (Given / When / Then).",
          "required": ["given", "when", "then"],
          "properties": {
            "given": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "then": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        { "required": ["statement"], "not": { "required": ["gherkin"] } },
        { "required": ["gherkin"], "not": { "required": ["statement"] } }
      ],
      "additionalProperties": false
    }
  }
}
